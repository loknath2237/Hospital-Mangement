# Copy this file to .env and adjust before your first run — the admin account
# is only seeded once, the first time the database is created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

PORT=4000

# Origin allowed to make authenticated (credentialed) requests to this API.
# Must match exactly where your frontend is served from.
CLIENT_ORIGIN=http://localhost:5173

# Not used by the current SQLite setup — kept as a placeholder for when you
# migrate to Postgres/Supabase (see README section 5).
# DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"
